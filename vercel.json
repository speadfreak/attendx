{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/facetrack run build",
  "outputDirectory": "artifacts/facetrack/dist/public",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cron",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/[...route].ts": {
      "maxDuration": 60
    }
  }
}